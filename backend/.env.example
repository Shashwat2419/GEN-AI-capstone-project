# Copy to .env for local development (never commit the real .env)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional server-side AI keys (users can also paste their own in the UI)
GEMINI_API_KEY=
GROQ_API_KEY=
# Comma-separated list of allowed frontends, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
